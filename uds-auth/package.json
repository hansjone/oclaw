{
  "name": "uds-auth",
  "version": "0.2.3",
  "description": "UDS authentication plugin for DeepSeek Harness with multi-tenant session isolation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./config": "./lib/config.js",
    "./session": "./lib/session/factory.js",
    "./middleware": "./lib/middleware/auth-middleware.js",
    "./api": "./lib/api.js",
    "./context": "./lib/context.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "authentication",
    "uds",
    "sso",
    "session-management",
    "multi-tenant"
  ],
  "files": [
    "lib",
    "skills",
    "skill-helpers",
    "config.default.yaml",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
